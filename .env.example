# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# Never commit .env.local or any other file containing real keys.

# ---------------------------------------------------------------------------
# Supabase (Auth + Storage)
# Find both values in the Supabase Dashboard: open the project, click "Connect".
# ---------------------------------------------------------------------------

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public client key: the anon key or the newer publishable key (sb_publishable_...).
# It is sent to the browser, so NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by Admin > User Management to delete the Auth user.
# Supabase Dashboard → Project Settings → API → service_role secret.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional canonical app origin for auth emails, e.g. http://localhost:3000.
# Add /auth/callback (and /auth/callback?next=/reset-password) to Supabase Redirect URLs.
# If empty, Server Actions use the request origin.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Database (owned by the database lead, who will fill these in)
# ---------------------------------------------------------------------------

# Pooled Postgres connection string used by the app at runtime. The database owner will fill this in.
DATABASE_URL=

# Direct (non-pooled) Postgres connection string used for migrations. The database owner will fill this in.
DIRECT_URL=

# ---------------------------------------------------------------------------
# Demo seed data (npm run db:seed:demo)
# The "User UID" of the two demo users created in Supabase Authentication.
# Ask the database owner for the demo emails and passwords.
# ---------------------------------------------------------------------------
SEED_MAYA_AUTH_ID=
SEED_ADMIN_AUTH_ID=
